[
  { "name": "ordinary text", "greeting": "Hello {user}!", "mentions": 1 },
  { "name": "repeated placeholders", "greeting": "{user}, welcome {user}!", "mentions": 2 },
  { "name": "bold", "greeting": "**Hello {user}!**", "mentions": 1, "selector": "strong .preview-mention" },
  { "name": "italic", "greeting": "*Hello {user}!*", "mentions": 1, "selector": "em .preview-mention" },
  { "name": "strikethrough", "greeting": "~~Hello {user}!~~", "mentions": 1, "selector": "del .preview-mention" },
  { "name": "spoiler", "greeting": "||Hello {user}!||", "mentions": 1, "selector": ".preview-spoiler .preview-mention" },
  { "name": "formatted spoiler", "greeting": "||*Hello {user}!*||", "mentions": 1, "selector": ".preview-spoiler em .preview-mention" },
  { "name": "multiline", "greeting": "Hello {user}\nWelcome aboard!", "mentions": 1, "selector": "br" },
  { "name": "code elsewhere", "greeting": "`literal code` Hello {user}", "mentions": 1, "selector": "code" },
  { "name": "fenced code elsewhere", "greeting": "```\nliteral code\n```\nHello {user}", "mentions": 1, "selector": "pre code" },
  { "name": "link elsewhere", "greeting": "[guide](https://example.com) Hello {user}", "mentions": 1, "selector": "a[href='https://example.com']" },
  { "name": "reference link elsewhere", "greeting": "[guide][ref] Hello {user}\n\n[ref]: https://example.com", "mentions": 1, "selector": "a[href='https://example.com']" },
  { "name": "no placeholder", "greeting": "Welcome aboard!", "mentions": 0 },
  { "name": "explicit URL separated by space", "greeting": "https://example.com {user}", "mentions": 1, "selector": "a[href='https://example.com']" },
  { "name": "www URL separated by space", "greeting": "www.example.com {user}", "mentions": 1, "selector": "a[href='http://www.example.com']" },
  { "name": "unknown www domain separated by space", "greeting": "www.example.invalid {user}", "mentions": 1, "selector": "a[href='http://www.example.invalid']" },
  { "name": "email separated by space", "greeting": "hello@example.com {user}", "mentions": 1, "selector": "a[href='mailto:hello@example.com']" },
  { "name": "autolink separated by space", "greeting": "<https://example.com> {user}", "mentions": 1, "selector": "a[href='https://example.com']" },
  { "name": "adjacent explicit link", "greeting": "[guide](https://www.localhost/){user}", "mentions": 1, "selector": "a[href='https://www.localhost/']" },
  { "name": "escaped punctuation", "greeting": "Welcome \\*{user}\\*!", "mentions": 1 },
  { "name": "normalized probe URI collision with valid placement", "greeting": "[x](root://user/welcome&#45;placeholder) www.example.com {user}", "mentions": 1 },
  { "name": "inline code", "greeting": "Hello `{user}`!", "mentions": null },
  { "name": "fenced code", "greeting": "```\n{user}\n```", "mentions": null },
  { "name": "indented code", "greeting": "    {user}", "mentions": null },
  { "name": "link label", "greeting": "[Hello {user}](https://example.com)", "mentions": null },
  { "name": "link destination", "greeting": "[guide](https://example.com/{user})", "mentions": null },
  { "name": "image label", "greeting": "![Hello {user}](https://example.com/image.png)", "mentions": null },
  { "name": "reference link label", "greeting": "[Hello {user}][ref]\n\n[ref]: https://example.com", "mentions": null },
  { "name": "escaped placeholder", "greeting": "\\{user}", "mentions": null },
  { "name": "image prefix", "greeting": "!{user}", "mentions": null },
  { "name": "www URL suffix", "greeting": "www.example.com/{user}", "mentions": null },
  { "name": "www URL brackets", "greeting": "www.example.com/[{user}]", "mentions": null },
  { "name": "www URL formatting", "greeting": "www.example.com/**{user}**", "mentions": null },
  { "name": "unknown www domain suffix", "greeting": "www.example.invalid/{user}", "mentions": null },
  { "name": "test www domain suffix", "greeting": "www.example.test/{user}", "mentions": null },
  { "name": "www localhost suffix", "greeting": "www.localhost/{user}", "mentions": null },
  { "name": "www localhost formatting", "greeting": "www.localhost/**{user}**", "mentions": null },
  { "name": "www URL encoded whitespace", "greeting": "www.example.invalid/&nbsp;{user}", "mentions": null },
  { "name": "www localhost encoded whitespace", "greeting": "www.localhost/&#32;{user}", "mentions": null },

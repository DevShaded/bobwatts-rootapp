{
  "name": "@bobwatts-rootapp/app",
  "description": "bobwatts-rootapp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bobwatts-rootapp/gen-client": "file:./networking/gen/client",
    "@bobwatts-rootapp/gen-server": "file:./networking/gen/server",
    "@bobwatts-rootapp/gen-shared": "file:./networking/gen/shared",
    "@rootsdk/client-app": "*",
    "@rootsdk/server-app": "*"
  },
  "devDependencies": {
    "@rootsdk/dev-tools": "*",
    "@types/node": "^22.10.2",
    "concurrently": "10.0.6",
    "tsc-watch": "7.2.1",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "node clean.js",
    "check:markdown-components": "node scripts/check-markdown-components.cjs",
    "test": "npm run check:markdown-components && node --test scripts/test/*.test.cjs && npm run build && node --test server/test/*.test.cjs && npm test --workspace=client"
  },
  "workspaces": {
    "packages": [
      "./networking",
      "./server",
      "./client"
    ]
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
